
# --- JWT authentication ---
# Generate with: php artisan jwt:secret
JWT_SECRET=
# Access token lifetime in minutes
JWT_TTL=60

# --- Payments ---
PAYMENT_CURRENCY=USD

# Credit card gateway
PAYMENT_CREDIT_CARD_ENABLED=true
CREDIT_CARD_API_KEY=
CREDIT_CARD_API_SECRET=

# PayPal gateway
PAYMENT_PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
